# Copy this file to .env and fill in your keys.

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: Gemini API for Gemini / Imagen images and Veo video. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: a local ComfyUI for images (see "Local images with ComfyUI" in README.md).
# Found on port 8000 (ComfyUI Desktop) or 8188 without this.
# COMFYUI_URL=http://127.0.0.1:8188

# Optional overrides
# PORT=3001        # API server
# WEB_PORT=5173    # editor UI (npm run dev)
# PROJECTS_DIR=projects   # one folder per video project
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
